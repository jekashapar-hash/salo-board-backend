# ============================================================
# Django
# ============================================================
SECRET_KEY=your-very-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# ============================================================
# База даних
# ============================================================
# True  → SQLite (dev, нічого не треба налаштовувати)
# False → PostgreSQL (вимагає DATABASE_URL нижче)
IS_DEV_DATABASE=True

# Використовується тільки коли IS_DEV_DATABASE=False
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

# ============================================================
# Redis / Celery
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Telegram бот (опціонально)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ============================================================
# Налаштування
# ============================================================
# Інтервал фонових перевірок статусів турнірів/раундів (хвилини)
CHECKER_INTERVAL_MINUTES=15
